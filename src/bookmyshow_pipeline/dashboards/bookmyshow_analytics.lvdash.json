{
  "datasets": [
    {
      "name": "ds_booking_revenue",
      "displayName": "Booking revenue",
      "asset_name": "mv_booking_revenue"
    },
    {
      "name": "ds_payment_health",
      "displayName": "Payment health",
      "asset_name": "mv_payment_health"
    },
    {
      "name": "ds_theatre_occupancy",
      "displayName": "Theatre occupancy",
      "asset_name": "mv_theatre_occupancy"
    },
    {
      "name": "ds_movie_performance",
      "displayName": "Movie performance detail",
      "asset_name": "gold_agg_movie_performance"
    },
    {
      "name": "ds_payment_worst",
      "displayName": "Worst gateway x city x date combinations",
      "queryLines": [
        "SELECT `Payment Gateway` AS payment_gateway, `City` AS city, `Booking Date` AS booking_date, \n",
        "  MEASURE(`Total Bookings`) AS total_bookings, \n",
        "  MEASURE(`Failed Bookings`) AS failed_bookings, \n",
        "  MEASURE(`Payment Failure Rate`) AS failure_rate \n",
        "FROM mv_payment_health \n",
        "GROUP BY ALL \n",
        "HAVING MEASURE(`Total Bookings`) >= 20 \n",
        "ORDER BY failure_rate DESC \n",
        "LIMIT 15"
      ]
    },
    {
      "name": "ds_top_movies",
      "displayName": "Top 10 movies by revenue",
      "queryLines": [
        "SELECT `Movie Title` AS movie_title, \n",
        "  MEASURE(`Total Revenue`) AS total_revenue, \n",
        "  MEASURE(`Total Bookings`) AS total_bookings \n",
        "FROM mv_booking_revenue \n",
        "GROUP BY ALL \n",
        "ORDER BY total_revenue DESC \n",
        "LIMIT 10"
      ]
    }
  ],
  "pages": [
