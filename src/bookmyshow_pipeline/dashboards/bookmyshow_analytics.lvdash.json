          "position": {"x": 0, "y": 0, "width": 12, "height": 1}
        },
        {
          "widget": {
            "name": "exec-subtitle",
            "multilineTextboxSpec": {
              "lines": ["Total revenue, bookings, and customer reach across all cities. All revenue/ticket-price figures reflect realized (successful, non-cancelled) transactions."]
            }
          },
          "position": {"x": 0, "y": 1, "width": 12, "height": 1}
        },
        {
          "widget": {
            "name": "kpi-total-revenue",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_booking_revenue",
                  "fields": [
                    {"name": "weekly(Booking Date)", "expression": "DATE_TRUNC(\"WEEK\", `Booking Date`)"},
                    {"name": "measure(Total Revenue)", "expression": "MEASURE(`Total Revenue`)"}
                  ],
                  "disaggregated": false,
                  "orders": [{"direction": "DESC", "expression": "DATE_TRUNC(\"WEEK\", `Booking Date`)"}]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(Total Revenue)",
                  "displayName": "Total Revenue",
                  "format": {"type": "number-currency", "currencyCode": "INR", "abbreviation": "compact", "decimalPlaces": {"type": "max", "places": 2}}
                },
                "period": {"fieldName": "weekly(Booking Date)"}
              },
              "frame": {"title": "Total Revenue", "showTitle": true}
            }
          },
          "position": {"x": 0, "y": 2, "width": 3, "height": 3}
        },
        {
