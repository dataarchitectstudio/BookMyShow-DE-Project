          },
          "position": {"x": 0, "y": 5, "width": 12, "height": 1}
        },
        {
          "widget": {
            "name": "failure-rate-by-date",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_payment_health",
                  "fields": [
                    {"name": "Booking Date", "expression": "`Booking Date`"},
                    {"name": "Payment Gateway", "expression": "`Payment Gateway`"},
                    {"name": "measure(Payment Failure Rate)", "expression": "MEASURE(`Payment Failure Rate`)"}
                  ],
                  "disaggregated": false,
                  "orders": [{"direction": "ASC", "expression": "`Booking Date`"}]
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {"fieldName": "Booking Date", "scale": {"type": "temporal"}},
                "y": {
                  "fieldName": "measure(Payment Failure Rate)",
                  "scale": {"type": "quantitative"},
                  "displayName": "Failure Rate",
                  "format": {"type": "number-percent", "decimalPlaces": {"type": "max", "places": 1}}
                },
                "color": {"fieldName": "Payment Gateway", "scale": {"type": "categorical"}}
              },
              "annotations": [
                {
                  "type": "vertical-line",
                  "encodings": {
                    "x": {"dataValue": "2026-07-30T00:00:00.000", "dataType": "DATETIME"},
                    "label": {"value": "Gateway outage"},
                    "color": {"value": {"hex": "#FF7E5C"}}
                  }
                }
              ],
              "frame": {"title": "Payment Failure Rate by Date and Gateway", "showTitle": true}
            }
          },
          "position": {"x": 0, "y": 6, "width": 12, "height": 6}
        },
        {
          "widget": {
            "name": "worst-header",
            "multilineTextboxSpec": {"lines": ["## Where & When: Worst-Hit Combinations"]}
          },
          "position": {"x": 0, "y": 12, "width": 12, "height": 1}
        },
        {
          "widget": {
            "name": "failure-heatmap",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_payment_health",
                  "fields": [
                    {"name": "City", "expression": "`City`"},
                    {"name": "Payment Gateway", "expression": "`Payment Gateway`"},
                    {"name": "measure(Payment Failure Rate)", "expression": "MEASURE(`Payment Failure Rate`)"}
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "heatmap",
              "encodings": {
                "x": {"fieldName": "Payment Gateway", "scale": {"type": "categorical"}},
                "y": {"fieldName": "City", "scale": {"type": "categorical"}},
                "color": {
                  "fieldName": "measure(Payment Failure Rate)",
                  "scale": {
                    "type": "quantitative",
                    "colorRamp": {"mode": "custom-sequential", "colors": {"start": "#99DDB4", "end": "#FF7E5C"}}
                  }
                },
                "label": {"show": true}
              },
              "frame": {
                "title": "Failure Rate: City x Gateway (all-time)",
                "showTitle": true,
                "showDescription": true,
                "description": "Narrow with the Booking Date filter to isolate a single day."
              }
            }
          },
          "position": {"x": 0, "y": 13, "width": 6, "height": 6}
        },
        {
          "widget": {
            "name": "worst-combos-table",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_payment_worst",
                  "fields": [
                    {"name": "payment_gateway", "expression": "`payment_gateway`"},
                    {"name": "city", "expression": "`city`"},
                    {"name": "booking_date", "expression": "`booking_date`"},
                    {"name": "total_bookings", "expression": "`total_bookings`"},
                    {"name": "failed_bookings", "expression": "`failed_bookings`"},
                    {"name": "failure_rate", "expression": "`failure_rate`"}
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {"fieldName": "payment_gateway", "displayName": "Gateway"},
                  {"fieldName": "city", "displayName": "City"},
                  {"fieldName": "booking_date", "displayName": "Date"},
                  {"fieldName": "total_bookings", "displayName": "Bookings"},
                  {"fieldName": "failed_bookings", "displayName": "Failed"},
                  {
                    "fieldName": "failure_rate",
                    "displayName": "Failure Rate",
                    "format": {"type": "number-percent", "decimalPlaces": {"type": "max", "places": 1}},
                    "style": {
                      "type": "basic",
                      "rules": [
                        {
                          "condition": {"operand": {"type": "data-value", "value": "0.3"}, "operator": ">="},
                          "backgroundColor": {"hex": "#FF7E5C"}
                        }
                      ]
                    }
                  }
                ]
              },
              "frame": {
                "title": "Worst Gateway x City x Date Combinations",
                "showTitle": true,
                "showDescription": true,
                "description": "Minimum 20 bookings in the slice, sorted by failure rate."
              }
            }
          },
          "position": {"x": 6, "y": 13, "width": 6, "height": 6}
