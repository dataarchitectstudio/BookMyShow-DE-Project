{
  "datasets": [
    {
      "name": "ds_bookings",
      "displayName": "Bookings",
      "queryLines": [
        "SELECT booking_date, city, state, screen_type, genre, is_blockbuster, payment_gateway, payment_status, booking_channel, is_cancelled, seats_booked, ticket_amount, net_amount FROM fact_bookings "
      ],
      "columns": [
        {
          "displayName": "Total Revenue",
          "description": "Net revenue from successful bookings",
          "expression": "SUM(CASE WHEN `payment_status`='SUCCESS' THEN `net_amount` ELSE 0 END)"
        },
        {
          "displayName": "Total Bookings",
          "description": "Count of booking transactions",
          "expression": "COUNT(1)"
        },
        {
          "displayName": "Failed Bookings",
          "description": "Count of failed-payment bookings",
          "expression": "SUM(CASE WHEN `payment_status`='FAILED' THEN 1 ELSE 0 END)"
        },
        {
          "displayName": "Payment Failure Rate",
          "description": "Share of bookings with a failed payment",
          "expression": "SUM(CASE WHEN `payment_status`='FAILED' THEN 1 ELSE 0 END) * 1.0 / COUNT(1)"
        },
        {
          "displayName": "Avg Ticket Price",
          "description": "Average gross ticket amount per booking",
          "expression": "AVG(`ticket_amount`)"
        },
        {
          "displayName": "Cancellation Rate",
          "description": "Share of successful bookings later cancelled",
          "expression": "SUM(CASE WHEN `is_cancelled` THEN 1 ELSE 0 END) * 1.0 / NULLIF(SUM(CASE WHEN `payment_status`='SUCCESS' THEN 1 ELSE 0 END), 0)"
        },
        {
          "displayName": "Total Tickets Sold",
          "description": "Seats booked across successful bookings",
          "expression": "SUM(CASE WHEN `payment_status`='SUCCESS' THEN `seats_booked` ELSE 0 END)"
        }
      ],
      "catalog": "bookmyshow_analytics_dev",
      "schema": "gold"
    },
    {
      "name": "ds_movies_top10",
      "displayName": "Top 10 movies by revenue",
      "queryLines": [
        "SELECT movie_id, title, genre, is_blockbuster, total_bookings, total_tickets_sold, total_revenue, avg_ticket_price, performance_label FROM agg_movie_performance ORDER BY total_revenue DESC LIMIT 10"
      ],
      "catalog": "bookmyshow_analytics_dev",
      "schema": "gold"
    },
    {
      "name": "ds_movies_top25",
      "displayName": "Movie performance detail (top 25 by revenue)",
      "queryLines": [
        "SELECT movie_id, title, genre, is_blockbuster, total_bookings, total_tickets_sold, total_revenue, avg_ticket_price, performance_label FROM agg_movie_performance ORDER BY total_revenue DESC LIMIT 25"
      ],
      "catalog": "bookmyshow_analytics_dev",
      "schema": "gold"
    },
    {
      "name": "ds_theatres",
      "displayName": "Theatre occupancy",
      "queryLines": [
        "SELECT theatre_id, theatre_name, city, screen_type, total_shows, total_seats_available, total_seats_booked, occupancy_rate FROM agg_theatre_occupancy "
      ],
      "catalog": "bookmyshow_analytics_dev",
      "schema": "gold"
    }
  ],
